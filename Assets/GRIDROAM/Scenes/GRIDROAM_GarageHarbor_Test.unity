  citizenName: "\u0130brahim Dede"
  citizenRole: Kadife Sk. No:24 Ev Sahibi
  vendorShopId: 
  isBrave: 1
  chatLines:
  - "Buyur gel delikanl\u0131! Kadife Soka\u011F\u0131'n\u0131n en eski bah\xE7eli
