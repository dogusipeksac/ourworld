  humanoid: {fileID: 1898792764}
  citizenName: "H\xFCseyin Abi"
  citizenRole: "Selman Bakkal & Manav \xB7 No:58"
  vendorShopId: shop_bakkal
  isBrave: 1
  chatLines:
  - "Ho\u015F geldin kom\u015Fu! D\u0131\u015Far\u0131daki manavdan taze meyve, arkadaki
    \u015Fark\xFCteriden peynir-sucuk, dolaptan dondurma alabilirsin!"
  - "Aziziye Caddesi'ndeki \u0130TO \u015Eehit Er Dursun S\u0131vaz \u0130lkokulu
