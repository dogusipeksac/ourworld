  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Gridroam.World.TownPedestrian
  waypoints:
  - {x: 46.2, y: 0.09, z: 10.700001}
  candidateSeats: []
  walkSpeed: 0
  turnSpeed: 6.5
  humanoid: {fileID: 1164443905}
  citizenName: Mehmet Amca
  citizenRole: 66 Selman Sk. Emekli Sakini
  vendorShopId: 
  isBrave: 1
  chatLines:
  - "Ho\u015F geldin delikanl\u0131, ge\xE7 otur! 30 y\u0131ld\u0131r bu sar\u0131
    evde otururum, Hamidiye'nin her ta\u015F\u0131n\u0131 bilirim."
  - "Sabah namaz\u0131na a\u015Fa\u011F\u0131da Abd\xFClkadir Udeh'in sonundaki Hz.
    Osman Camii'ne y\xFCr\xFCr\xFCm."
  - "Kar\u015F\u0131daki Hafsa Tesisat'taki Mahmut Usta ge\xE7en k\u0131\u015F bizim
    petekleri temizledi, ev hamam gibi oldu."
  - "Eskiden buralar hep Aydos Orman\u0131'na bakan tarlayd\u0131, \u015Fimdi koca
    Sultanbeyli oldu."
