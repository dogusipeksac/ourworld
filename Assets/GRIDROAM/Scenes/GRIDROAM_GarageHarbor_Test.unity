  m_Script: {fileID: 11500000, guid: c686b890a3a4049c190d1885e2ef182a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OurWorld.World.TownPedestrian
  waypoints:
  - {x: -41.4, y: 0.09, z: 197.40001}
  candidateSeats: []
  walkSpeed: 0
  turnSpeed: 6.5
  humanoid: {fileID: 137971275}
  citizenName: "G\xFClten Teyze"
  citizenRole: Havadis Sk. No:12 Ev Sahibi
  vendorShopId: 
  isBrave: 1
  chatLines:
  - "Ho\u015F geldin evlad\u0131m, Havadis Soka\u011F\u0131'na yeni ta\u015F\u0131nd\u0131k!
    Evin i\xE7i ferah, giri\u015Fi de tertemiz a\xE7\u0131ld\u0131."
  - "Hemen yan\u0131m\u0131zdaki Haydar Usta'n\u0131n ta\u015F f\u0131r\u0131n\u0131ndan
    sabah b\xF6rek al\u0131p balkonda \xE7ay i\xE7iyoruz."
  - "Fatih Bulvar\u0131'n\u0131n bir \xFCst soka\u011F\u0131 oldu\u011Fundan hem
    sessiz hem her yere y\xFCr\xFCyerek gidiliyor."
