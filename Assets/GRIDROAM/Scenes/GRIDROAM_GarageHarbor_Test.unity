  m_Script: {fileID: 11500000, guid: c686b890a3a4049c190d1885e2ef182a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OurWorld.World.TownPedestrian
  waypoints:
  - {x: -67.4, y: 0.09, z: 11.75}
  candidateSeats: []
  walkSpeed: 0
  turnSpeed: 6.5
  humanoid: {fileID: 1351970817}
  citizenName: Emine Teyze
  citizenRole: 48 Selman Sk. Ev Sahibi
  vendorShopId: 
  isBrave: 1
  chatLines:
  - "Ho\u015F geldin evlad\u0131m, buyur i\xE7eri! Demlikte taze \xE7ay var, sehpan\u0131n
    \xFCst\xFCne koydum."
  - "48 numaran\u0131n \xF6n\xFCndeki asma \xE7arda\u011F\u0131n\u0131 rahmetli beyimle
    dikmi\u015Ftik, yaz\u0131n g\xF6lgesinde otururuz."
  - "Hamidiye Mahallesi eskiden hep b\xF6yle bah\xE7eli m\xFCstakil evlerdi, \u015Fimdi
    arkam\u0131zda yeni binalar y\xFCkseliyor."
  - "Pazar g\xFCnleri torunlarla Sultanbeyli G\xF6let'e y\xFCr\xFCy\xFC\u015Fe iniyoruz,
    havas\u0131 Aydos'tan serin gelir."
