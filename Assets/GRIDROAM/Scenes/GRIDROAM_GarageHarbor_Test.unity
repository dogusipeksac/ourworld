  m_EditorClassIdentifier: Assembly-CSharp::OurWorld.World.TownPedestrian
  waypoints:
  - {x: 78.2, y: 0.04, z: -33.2}
  candidateSeats: []
  walkSpeed: 0
  turnSpeed: 6.5
  humanoid: {fileID: 1001678115}
  citizenName: Ahmet Hoca
  citizenRole: "Hz. Osman Camii \u0130mam Hatibi"
  vendorShopId: 
  isBrave: 1
  chatLines:
  - "Sel\xE2m\xFCn aleyk\xFCm evlad\u0131m, Hz. Osman Camii'ne ho\u015F geldin!"
  - "Avludaki mermer \u015Fad\u0131rvanda abdestini al\u0131p i\xE7eri buyurabilir,
    ye\u015Fil saflarda huzurla namaz\u0131n\u0131 k\u0131labilirsin."
  - "Abd\xFClkadir Udeh ile Selman Soka\u011F\u0131'n\u0131n t\xFCm kom\u015Fular\u0131
    be\u015F vakit burada bulu\u015Fur, kap\u0131m\u0131z herkese her zaman a\xE7\u0131kt\u0131r."
  - "Allah ibadetlerini kabul etsin, g\xF6nl\xFCn daim ferah olsun."
