    { "key": "m01.title", "value": "Get the Keys" },
    { "key": "m01.summary", "value": "Walk to the garage, talk to the mechanic, get the sedan keys, and get inside the car." },
    { "key": "m01.step1.objective", "value": "Walk to the repair garage and talk to Marco." },
    { "key": "m01.step2.objective", "value": "Get into the parked sedan outside the garage." },
    { "key": "m01.dlg.1", "value": "Morning! Good timing — the sedan is tuned and fueled up." },
    { "key": "m01.dlg.2", "value": "Here are the keys. Harbor dispatch just called about an urgent spare-parts crate." },
    { "key": "m01.dlg.3", "value": "Hop in the sedan. Take the coastal road or cut through the town streets if you know the turns." },

    { "key": "m02.title", "value": "Last Delivery" },
    { "key": "m02.summary", "value": "Deliver the spare parts to the cargo harbor before time runs out." },
    { "key": "m02.step1.objective", "value": "Drive to the Cargo Harbor delivery bay before the timer expires." },
    { "key": "m02.step2.objective", "value": "Step out and speak with Elena at the harbor dock." },
    { "key": "m02.dlg.1", "value": "You made it before the shift cutoff. Drop the crate right here — thanks." },
    { "key": "m02.dlg.2", "value": "Wait a second before you leave. One of our cargo sedans never checked back in today." },
    { "key": "m02.dlg.3", "value": "Last anyone saw it, a dark sedan was parked in the Harbor Town back alleys. Could you search for it on foot?" },

    { "key": "m03.title", "value": "Missing Car" },
    { "key": "m03.summary", "value": "Search the neighborhood on foot for the described car and find the next shipment address." },
    { "key": "m03.step1.objective", "value": "Head into the apartment neighborhood back alleys and locate the missing dark sedan." },
    { "key": "m03.step2.objective", "value": "Inspect the missing car on foot to find the next shipment address." },
    { "key": "m03.dlg.1", "value": "Plate matches — this is Elena's missing cargo sedan. The driver's door was left unlatched." },
    { "key": "m03.dlg.2", "value": "There's a manifest slip in the glovebox: 'Courier leaving the harbor gate will drop the package in the north alley.'" },
    { "key": "m03.dlg.3", "value": "If I head back to the harbor exit now, I can tail that courier car to the drop point." },

    { "key": "m04.title", "value": "Night Tail" },
    { "key": "m04.summary", "value": "Follow the car leaving the harbor without losing sight or getting too close, then collect the dropped package." },
    { "key": "m04.step1.objective", "value": "Drive to the lookout point outside the Cargo Harbor exit." },
    { "key": "m04.step2.objective", "value": "Follow the courier car without losing sight or getting too close (12m – 75m)." },
    { "key": "m04.step3.objective", "value": "Collect the dropped package on foot where the courier stopped." },
    { "key": "m04.dlg.1", "value": "Got the sealed package. It holds the original harbor manifests and garage invoices." },
    { "key": "m04.dlg.2", "value": "Marco wants this brought back to the repair garage, while Elena is waiting at the town square." },

    { "key": "m05.title", "value": "End of Shift" },
    { "key": "m05.summary", "value": "Return to the neighborhood via either route and deliver the package to Marco or Elena." },
    { "key": "m05.step1.objective", "value": "Return to the neighborhood via the coastal road or the narrow back streets." },
    { "key": "m05.step2.objective", "value": "Deliver the package to Marco at the garage OR to Elena waiting at the town square." },
    { "key": "m05.marco.dlg.1", "value": "I knew harbor dispatch was behind the mix-up. Bringing the package to me was the smart move." },
    { "key": "m05.marco.dlg.2", "value": "With these records, nobody can pin the missing parts on our shop. Here's your cut (+₺ 300)." },
    { "key": "m05.marco.dlg.3", "value": "Shift's over, kid. Keep the sedan keys and roam the town however you like!" },
    { "key": "m05.elena.dlg.1", "value": "I hoped you'd bring the package straight to me! The missing manifest logs are all right here." },
    { "key": "m05.elena.dlg.2", "value": "I cleared your bonus with harbor operations (+₺ 300). You saved the entire shift tonight." },
    { "key": "m05.elena.dlg.3", "value": "You're off the clock now — explore Harbor Town freely or pick up side jobs whenever you want!" }
  ]
}
