    { "key": "m01.title", "value": "Anahtarları Al" },
    { "key": "m01.summary", "value": "Tamirhaneye yürü, ustayla konuş, anahtarı al ve arabaya bin." },
    { "key": "m01.step1.objective", "value": "Tamirhaneye yürü ve Marco ile konuş." },
    { "key": "m01.step2.objective", "value": "Tamirhanenin önündeki sedana bin." },
    { "key": "m01.dlg.1", "value": "İyi akşamlar. Tam zamanında geldin — sedan hazır, deposu dolu." },
    { "key": "m01.dlg.2", "value": "Anahtarlar burada. Limandan acil bir yedek parça sevkiyatı için aradılar." },
    { "key": "m01.dlg.3", "value": "Arabaya geç. İstersen sahil yolundan, istersen dar sokaklardan kestirme git." },

    { "key": "m02.title", "value": "Son Teslimat" },
    { "key": "m02.summary", "value": "Yedek parçayı süre dolmadan limana teslim et." },
    { "key": "m02.step1.objective", "value": "Süre dolmadan Yük Limanı teslimat alanına sür." },
    { "key": "m02.step2.objective", "value": "Araçtan in ve limandaki Elena ile konuş." },
    { "key": "m02.dlg.1", "value": "Vardiya kapanmadan yetiştin. Kasayı buraya bırakabilirsin, teşekkürler." },
    { "key": "m02.dlg.2", "value": "Gitmeden bir dakika. Bizim araçlardan biri bu akşam hâlâ geri dönmedi." },
    { "key": "m02.dlg.3", "value": "En son apartmanların olduğu mahallede koyu renkli bir sedan görülmüş. Gözün açık olsun." },

    { "key": "m03.title", "value": "Kayıp Araç" },
    { "key": "m03.summary", "value": "Tarif edilen aracı mahallede yaya olarak ara ve bir sonraki sevkiyat adresini bul." },
    { "key": "m04.title", "value": "Gece Takibi" },
    { "key": "m04.summary", "value": "Limandan çıkan arabayı gözden kaybetmeden ve fazla yaklaşmadan takip et, bırakılan paketi al." },
    { "key": "m05.title", "value": "Vardiya Sonu" },
    { "key": "m05.summary", "value": "İki rotadan biriyle mahalleye dön ve paketi Marco'ya veya Elena'ya teslim et." }
  ]
