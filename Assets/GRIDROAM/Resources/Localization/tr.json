    { "key": "npc.mechanic.name", "value": "Marco (Tamirhane Ustası)" },
    { "key": "npc.harbor_receiver.name", "value": "Elena (Kargo Sorumlusu)" },
    { "key": "npc.player.name", "value": "Not Defteri" },
    { "key": "m01.title", "value": "Anahtarları Al" },
    { "key": "m01.summary", "value": "Tamirhaneye yürü, ustayla konuş, anahtarı al ve arabaya bin." },
    { "key": "m01.step1.objective", "value": "Tamirhaneye yürü ve Marco ile konuş." },
    { "key": "m01.step2.objective", "value": "Tamirhanenin önündeki sedana bin." },
    { "key": "m01.dlg.1", "value": "Günaydın! Tam zamanında geldin — sedan bakımdan çıktı, deposu dolu." },
    { "key": "m01.dlg.2", "value": "Anahtarlar burada. Kuzey Kargo Deposu'ndan acil bir yedek parça sevkiyatı için aradılar." },
    { "key": "m01.dlg.3", "value": "Arabaya geç. İstersen Cumhuriyet Caddesi'nden, istersen Çınar Caddesi sokaklarından git." },
    { "key": "m02.title", "value": "Son Teslimat" },
    { "key": "m02.summary", "value": "Yedek parçayı süre dolmadan Kuzey Kargo Deposu'na teslim et." },
    { "key": "m02.step1.objective", "value": "Süre dolmadan Kuzey Kargo Deposu teslimat alanına sür." },
    { "key": "m02.step2.objective", "value": "Araçtan in ve depodaki Elena ile konuş." },
    { "key": "m02.dlg.1", "value": "Vardiya kapanmadan yetiştin. Kasayı buraya bırakabilirsin, teşekkürler." },
    { "key": "m02.dlg.2", "value": "Gitmeden bir dakika. Bizim araçlardan biri bugün hâlâ geri dönmedi." },
    { "key": "m02.dlg.3", "value": "En son Çınarlı Kasabası konut sokaklarında koyu renkli bir sedan görülmüş. Yaya olarak bir bakabilir misin?" },
    { "key": "m03.title", "value": "Kayıp Araç" },
    { "key": "m03.summary", "value": "Tarif edilen aracı mahallede yaya olarak ara ve bir sonraki sevkiyat adresini bul." },
    { "key": "m03.step1.objective", "value": "Batı konut mahallesine git ve kayıp koyu renkli aracı bul." },
    { "key": "m03.step2.objective", "value": "Araçtan inip kayıp sedanı yaya olarak incele ve sevkiyat adresini bul." },
    { "key": "m03.dlg.1", "value": "Plaka eşleşiyor — Elena'nın bahsettiği kayıp kargo sedanı bu. Kapısı aralık bırakılmış." },
    { "key": "m03.dlg.2", "value": "Torpido gözünde bir manifesto notu var: 'Depo çıkışından kalkan kurye aracı paketi batı sokak buluşma noktasına bırakacak.'" },
    { "key": "m03.dlg.3", "value": "Hemen depo çıkışına dönersem kurye aracını yakalayıp uzaktan takip edebilirim." },
    { "key": "m04.title", "value": "Gece Takibi" },
    { "key": "m04.summary", "value": "Depodan çıkan arabayı gözden kaybetmeden ve fazla yaklaşmadan takip et, bırakılan paketi al." },
    { "key": "m04.step1.objective", "value": "Kuzey Kargo Deposu çıkışındaki gözetleme noktasına git." },
    { "key": "m04.step2.objective", "value": "Kurye aracını gözden kaybetmeden ve fazla yaklaşmadan takip et (12m – 75m)." },
    { "key": "m04.step3.objective", "value": "Kuryenin batı sokakta bıraktığı paketi yaya olarak al." },
    { "key": "m04.dlg.1", "value": "Mühürlü sevkiyat paketi burada. İçinde depo kayıtlarıyla tamirhane faturalarının asılları var." },
    { "key": "m04.dlg.2", "value": "Marco paketi tamirhanede beklediğini söylemişti; Elena ise kasaba meydanında haber bekliyor." },
    { "key": "m05.title", "value": "Vardiya Sonu" },
    { "key": "m05.summary", "value": "İki rotadan biriyle merkeze dön ve paketi Marco'ya veya Elena'ya teslim et." },
    { "key": "m05.step1.objective", "value": "Cumhuriyet Caddesi veya Çınar Caddesi üzerinden kasaba merkezine dön." },
    { "key": "m05.step2.objective", "value": "Paketi tamirhanedeki Marco'ya VEYA kasaba meydanındaki Elena'ya teslim et." },
    { "key": "m05.marco.dlg.1", "value": "Biliyordum bu işin altından depo kuryesinin çıkacağını. Paketi bana getirmekle doğru yaptın." },
    { "key": "m05.marco.dlg.2", "value": "Bu belgelerle tamirhaneyi kimse suçlayamaz. Al bakalım, bu da senin payın (+300 ₺)." },
    { "key": "m05.marco.dlg.3", "value": "Vardiyan bitti evlat. Sedan artık sende kalsın — kasabada istediğin gibi takılabilirsin!" },
    { "key": "m05.elena.dlg.1", "value": "Paketi doğrudan bana getireceğini tahmin etmiştim! Kayıp sevkiyatın kaydı tam da bu çantadaymış." },
    { "key": "m05.elena.dlg.2", "value": "Depo yönetiminden ödülünü hemen onayladım (+300 ₺). Sayende bu vardiyayı temiz kapattık." },
    { "key": "m05.elena.dlg.3", "value": "Artık serbestsin — Çınarlı Kasabası'nda dilediğin gibi gezebilir veya yan işlere bakabilirsin!" },
    { "key": "npc.ayse.name", "value": "Ayşe Teyze" },
    { "key": "npc.efe.name", "value": "Küçük Efe" },
    { "key": "npc.pharmacist.name", "value": "Eczacı Selin" },
    { "key": "npc.muhtar.name", "value": "Muhtar Remzi Bey" },
    { "key": "npc.ayse.idle", "value": "Hayırlı günler evladım, Selman Sokağı'nda herkes birbirini tanır." },
    { "key": "npc.efe.idle", "value": "Abi top oynayalım mı? Gürsu Sokağı'ndaki sahada maç var!" },
    { "key": "npc.pharmacist.idle", "value": "Nöbetçi eczane bu hafta bizde. Geçmiş olsun dileklerimle." },
    { "key": "npc.muhtar.idle", "value": "Mahallemizin her derdine koşarız, kapımız herkese açık." },
    { "key": "ui.btn.pickup_cat", "value": "Kediyi Al" },
    { "key": "m06.title", "value": "Bakkal Siparişi" },
    { "key": "m06.summary", "value": "Ayşe Teyze'nin alışverişini Hüseyin Abi'nin bakkalından getir." },
    { "key": "m06.step1.objective", "value": "Güney kaldırımındaki Ayşe Teyze ile konuş." },
    { "key": "m06.step2.objective", "value": "Selman Bakkal'ın önündeki alışveriş poşetini al." },
    { "key": "m06.step3.objective", "value": "Poşeti soğumadan Ayşe Teyze'ye teslim et." },
    { "key": "m06.dlg.a1", "value": "Evladım dizlerim tutmuyor, bakkala kadar yürüyemedim." },
    { "key": "m06.dlg.a2", "value": "Hüseyin Abi siparişimi hazırladı, kapının önünde. Getirir misin?" },
    { "key": "m06.dlg.b1", "value": "Ekmek, süt, bir paket çay… Ayşe Teyze'nin siparişi tamam." },
    { "key": "m06.dlg.c1", "value": "Allah razı olsun yavrum! Çayımı demleyip seni bekleyeceğim." },
    { "key": "m06.dlg.c2", "value": "Al şu harçlığı da, sakın geri çevirme (+300 ₺)." },
    { "key": "m07.title", "value": "Kayıp Kedi Pamuk" },
    { "key": "m07.summary", "value": "Küçük Efe'nin beyaz kedisi Pamuk'u mahallede bul." },
    { "key": "m07.step1.objective", "value": "Ağlayan Küçük Efe ile konuş." },
    { "key": "m07.step2.objective", "value": "Gürsu Sokağı'ndaki futbol sahasına bak." },
    { "key": "m07.step3.objective", "value": "Sahada yerde duran tasmayı incele." },
    { "key": "m07.step4.objective", "value": "Hz. Osman Camii avlusunda Pamuk'u bul ve kucağına al." },
    { "key": "m07.step5.objective", "value": "Pamuk'u Küçük Efe'ye geri götür." },
    { "key": "m07.dlg.a1", "value": "Pamuk kayboldu! Sabah top oynarken peşimizden geliyordu…" },
    { "key": "m07.dlg.a2", "value": "Futbol sahasına bakabilir misin? Ben çok korkuyorum." },
    { "key": "m07.dlg.b1", "value": "Pamuk'un mavi tasması! Üzerinde balık kılçığı var…" },
    { "key": "m07.dlg.b2", "value": "Cami avlusunda kedilere mama veriliyor. Oraya gitmiş olmalı." },
    { "key": "m07.dlg.c1", "value": "İşte burada! Pamuk mırlayarak kollarıma atladı." },
    { "key": "m07.dlg.d1", "value": "PAMUK! Teşekkürler abi, sen bir kahramansın!" },
    { "key": "m07.dlg.d2", "value": "Annem bu parayı sana vermemi söyledi (+350 ₺)." },
    { "key": "m08.title", "value": "Acil Eczane" },
    { "key": "m08.summary", "value": "Ayşe Teyze'nin eşinin ilacını zamanında eczaneden getir." },
    { "key": "m08.step1.objective", "value": "Telaşlı Ayşe Teyze ile konuş." },
    { "key": "m08.step2.objective", "value": "Hemen arabana bin." },
    { "key": "m08.step3.objective", "value": "Süre bitmeden doğudaki nöbetçi eczaneye arabayla ulaş." },
    { "key": "m08.step4.objective", "value": "Eczacı Selin'den ilacı al." },
    { "key": "m08.step5.objective", "value": "İlacı hızla Ayşe Teyze'ye yetiştir." },
    { "key": "m08.dlg.a1", "value": "Evladım, Hasan Amca'nın tansiyon ilacı bitmiş, başı dönüyor!" },
    { "key": "m08.dlg.a2", "value": "Nöbetçi eczane sokağın doğu ucunda. Arabanla gidersen yetişirsin!" },
    { "key": "m08.dlg.b1", "value": "Hasan Bey'in reçetesi hazır. Günde bir tane, tok karnına." },
    { "key": "m08.dlg.b2", "value": "Acele et, geç kalmasın. Geçmiş olsun!" },
    { "key": "m08.dlg.c1", "value": "Yetiştin! Hasan Amca ilacını içti, rengi yerine geldi." },
    { "key": "m08.dlg.c2", "value": "Sen bu mahallenin meleğisin evladım (+400 ₺)." },
    { "key": "m09.title", "value": "Ustanın Parçası" },
    { "key": "m09.summary", "value": "Marco Usta'nın benzinlikte unutulan yedek parçasını tamirhaneye getir." },
    { "key": "m09.step1.objective", "value": "Tamirhanedeki Marco Usta ile konuş." },
    { "key": "m09.step2.objective", "value": "Arabayla batıdaki benzin istasyonuna git." },
    { "key": "m09.step3.objective", "value": "Araçtan in ve yedek parça kutusunu al." },
    { "key": "m09.step4.objective", "value": "Müşteri beklemeden parçayı arabayla tamirhaneye getir." },
    { "key": "m09.step5.objective", "value": "Parçayı Marco Usta'ya teslim et." },
    { "key": "m09.dlg.a1", "value": "Kargocu parçayı yanlışlıkla benzinliğe bırakmış, müşteri de kapıda!" },
    { "key": "m09.dlg.a2", "value": "Arabayla git, kutuyu al ve hemen dön. Sana güveniyorum." },
    { "key": "m09.dlg.b1", "value": "Triger seti — kutunun üstünde 'Oto Tamir No:73' yazıyor." },
    { "key": "m09.dlg.c1", "value": "Tam zamanında! Müşterinin arabası öğlene hazır olur." },
    { "key": "m09.dlg.c2", "value": "Bu da emeğinin karşılığı (+450 ₺). Arabanı da bir göz attım." },
    { "key": "m10.title", "value": "Mahalle Şenliği" },
    { "key": "m10.summary", "value": "Elena ile mahalle şenliğini hazırla ve Muhtar Remzi Bey'e haber ver." },
    { "key": "m10.step1.objective", "value": "No:66 önündeki Elena ile konuş." },
    { "key": "m10.step2.objective", "value": "Çay Ocağı önündeki çay kolisini al." },
    { "key": "m10.step3.objective", "value": "Bakkalın yanındaki simit tepsisini al." },
    { "key": "m10.step4.objective", "value": "Şenlik alanına (Gürsu Sk. futbol sahası) git." },
    { "key": "m10.step5.objective", "value": "Muhtar Remzi Bey'e şenliğin hazır olduğunu söyle." },
    { "key": "m10.dlg.a1", "value": "Bu akşam mahalle şenliği var ve çay ile simit hâlâ gelmedi!" },
    { "key": "m10.dlg.a2", "value": "Çay Ocağı'ndan çayı, bakkalın yanından simitleri alıp sahaya götürür müsün?" },
    { "key": "m10.dlg.b1", "value": "Kocaman bir koli Rize çayı. Bu gece semaverler boş kalmayacak." },
    { "key": "m10.dlg.c1", "value": "Sıcacık susamlı simitler… Mis gibi kokuyor." },
    { "key": "m10.dlg.d1", "value": "Maşallah! Çay da simit de tamam, şenlik başlayabilir." },
    { "key": "m10.dlg.d2", "value": "Bütün mahalle senden bahsediyor. Bu ödül hepimizden (+1000 ₺)." },
    { "key": "m10.dlg.d3", "value": "Bölüm 1 bitti! Yeni sokaklar ve görevler yakında. Fikirlerini telefondaki Öneri sekmesinden bize yaz!" },
