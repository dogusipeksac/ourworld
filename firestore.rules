rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Project: OurWorld (Firebase project: ourworld-dd8dc)
// Database: (default) — Cloud Firestore Standard Edition
// Auth: Firebase Anonymous Auth over REST (FeedbackService.cs)
//
// Collection: feedback
// Document ID: auto-generated by Firestore on REST POST (constrained to 1..64 safe ID chars)
// Access Pattern: Append-only from game clients; moderation (status
//   transitions to 'planned' / 'done' / 'exported', deletion) occurs
//   exclusively via Firebase Console or Admin SDK.
// Fields (exact set required on create — no extraneous fields):
//   - text: string (required, trimmed length 5..1000, raw length 5..1000)
//       Player idea, bug report, or community board message.
//   - senderName: string (required, trimmed non-empty, length 1..32)
//       Player-chosen display name shown on the community board (non-PII).
//   - category: string (required, enum: 'idea' | 'bug' | 'other')
//       Submission category.
//   - status: string (required, must be 'new' on client create;
//       moderators may set 'planned', 'done', or 'exported' via Admin SDK/Console)
//   - uid: string (required, immutable, length 1..128, must equal request.auth.uid)
//       Anonymous Firebase Auth UID of the submitting player.
//   - appVersion: string (required, trimmed length 1..32, safe version charset)
//       Game client version string (Application.version).
//   - platform: string (required, trimmed length 1..40, enum-identifier charset)
//       Runtime platform name (Application.platform).
//   - language: string (required, trimmed length 2..8, BCP-47/ISO code format)
//       Active game language code (e.g., 'tr', 'en').
//   - completedMissions: int (required, range 0..1000)
//       Count of completed missions at submission time.
//   - playMinutes: int (required, range 0..1000000)
//       Total play time in minutes at submission time.
//   - createdAt: timestamp (required, immutable, bounded within
//       [request.time - 10m, request.time + 5m] to block future-pinning and backfill spoofing)
//       Submission timestamp.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request comes from an authenticated user (including Anonymous Auth)
    function isAuthenticated() {
      return request.auth != null &&
        request.auth.uid is string &&
        request.auth.uid.size() > 0;
    }

    // Verify uid on create matches the authenticated caller
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    // Validate that all required fields exist in the incoming document
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the incoming document contains only allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate a string field's raw length bounds
    function validStringLength(value, minLen, maxLen) {
      return value is string &&
        value.size() >= minLen &&
        value.size() <= maxLen;
    }

    // Validate a non-empty trimmed string within length bounds
    function validTrimmedString(value, minTrimmedLen, maxRawLen) {
      return validStringLength(value, minTrimmedLen, maxRawLen) &&
        value.trim().size() >= minTrimmedLen;
    }

    // Validate an integer within inclusive [minVal, maxVal] bounds
    function validIntRange(value, minVal, maxVal) {
      return value is int &&
        value >= minVal &&
        value <= maxVal;
    }

    // Validate that a client-supplied timestamp is bounded around server request.time.
    // Allows up to +5 min forward clock skew and -10 min backward skew / transit latency,
    // preventing future-pinning (e.g., year-2099 spam) and far-past backfill spoofing.
    function isRecentTimestamp(ts) {
      return ts is timestamp &&
        ts <= request.time + duration.value(5, 'm') &&
        ts >= request.time - duration.value(10, 'm');
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function feedbackFields() {
      return [
        'text',
        'senderName',
        'category',
        'status',
        'uid',
        'appVersion',
        'platform',
        'language',
        'completedMissions',
        'playMinutes',
        'createdAt'
      ];
    }

    function isValidFeedback(data) {
      return hasOnlyAllowedFields(feedbackFields()) &&
        hasRequiredFields(feedbackFields()) &&
        validTrimmedString(data.text, 5, 1000) &&
        validTrimmedString(data.senderName, 1, 32) &&
        data.category is string &&
        data.category in ['idea', 'bug', 'other'] &&
        data.status is string &&
        data.status == 'new' &&
        validStringLength(data.uid, 1, 128) &&
        data.uid == request.auth.uid &&
        validTrimmedString(data.appVersion, 1, 32) &&
        data.appVersion.matches('^[A-Za-z0-9._+ -]+$') &&
        validTrimmedString(data.platform, 1, 40) &&
        data.platform.matches('^[A-Za-z0-9_]+$') &&
        validTrimmedString(data.language, 2, 8) &&
        data.language.matches('^[A-Za-z]{2,3}([_-][A-Za-z0-9]{2,4})?$') &&
        validIntRange(data.completedMissions, 0, 1000) &&
        validIntRange(data.playMinutes, 0, 1000000) &&
        isRecentTimestamp(data.createdAt);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /feedback/{docId} {
      // Signed-in players may read individual entries and list recent entries
      // for the in-game community ideas board (bounded to max 50 per query, no offset skipping).
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() &&
        request.query.limit != null &&
        request.query.limit is int &&
        request.query.limit > 0 &&
        request.query.limit <= 50 &&
        (!('offset' in request.query) || request.query.offset == null || request.query.offset == 0);

      // Signed-in players may append validated feedback attributed to their own uid.
      allow create: if isAuthenticated() &&
        docId.matches('^[A-Za-z0-9_-]{1,64}$') &&
        uidUnchanged() &&
        isValidFeedback(request.resource.data);

      // Append-only from game clients; moderation occurs via Admin SDK / Console.
      allow update: if false;
      allow delete: if false;
    }

    // ===============================================================
    // Default Catch-All Deny
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
